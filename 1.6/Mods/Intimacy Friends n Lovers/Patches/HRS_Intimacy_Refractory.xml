<?xml version="1.0" encoding="utf-8"?>
<Patch>
	
	<Operation Class="XmlExtensions.OptionalPatch">
		<modId>FrozenSnowFox.FrozenSnowFoxTweaks</modId>
		<key>FSFHumanReproductonOn</key>
		<defaultValue>false</defaultValue>
		<caseTrue>
			
		<!-- Option is nested so patch isn't always run -->

			
			
			
		<!-- Human Refractory Duration -->
			
	<Operation Class="XmlExtensions.UseSetting">
		<modId>FrozenSnowFox.FrozenSnowFoxTweaks</modId>
		<key>FSFRefractoryDuration</key>
		<defaultValue>300000</defaultValue>
		<apply>
			
		<Operation Class="PatchOperationSequence">
			<success>Normal</success>
			<operations>
				
			<li Class="PatchOperationReplace">
				<xpath>/Defs/HediffDef[defName = "SEX_PostBirth"]/comps/li[@Class = "HediffCompProperties_Disappears"]/disappearsAfterTicks</xpath>
				<value>
					<disappearsAfterTicks>{FSFRefractoryDuration}</disappearsAfterTicks>
				</value>
			</li>
				
			</operations>
		</Operation>
			
		</apply>
	</Operation>
			
			
			
		</caseTrue>
	</Operation>

</Patch>