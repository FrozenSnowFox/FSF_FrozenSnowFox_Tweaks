<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="XmlExtensions.OptionalPatch">
		<modId>FrozenSnowFox.FrozenSnowFoxTweaks</modId>
		<key>FSFBetterTrapsOn</key>
		<defaultValue>false</defaultValue>
		<caseTrue>
			
		<!-- Option is nested so patch isn't always run -->
	
	
	
	<Operation Class="XmlExtensions.OptionalPatch">
		<modId>FrozenSnowFox.FrozenSnowFoxTweaks</modId>
		<key>FSFBetterTrapsCostOn</key>
		<defaultValue>false</defaultValue>
		<caseTrue>
			
		<!-- Option is nested so patch isn't always run -->
	
	<Operation Class="XmlExtensions.UseSetting">
		<modId>FrozenSnowFox.FrozenSnowFoxTweaks</modId>
		<key>FSFBetterTrapsBearTrapCost</key>
		<defaultValue>65</defaultValue>
		<apply>
			
		<Operation Class="PatchOperationSequence">
			<success>Normal</success>
			<operations>
				
			<!-- Vanilla Furniture Expanded Security - Bear Trap -->
				
			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef[defName = "VFES_BearTrap"]/costStuffCount</xpath>
				<value>
					<costStuffCount>{FSFBetterTrapsBearTrapCost}</costStuffCount>
				</value>
			</li>
				
			</operations>
		</Operation>
			
		</apply>
	</Operation>
			
		</caseTrue>
	</Operation>
	
	
	
		</caseTrue>
	</Operation>

</Patch>