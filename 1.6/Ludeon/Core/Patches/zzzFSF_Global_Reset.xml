<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	
		<Operation Class="PatchOperationSequence">
			<success>Normal</success>
			<operations>
				
			<li Class="PatchOperationAdd">
				<xpath>/Defs/XmlExtensions.SettingsMenuDef[defName = "FrozenSnowFoxTweaksSettings"]/settings/li[tag="FrozenSnowFoxTweaksGlobalReset"]/settings</xpath>
				<value>

			
						
			<li Class="XmlExtensions.Setting.CollapsibleSettings">
				<label>Reset All Mod settings</label>
				<headerFont>Medium</headerFont>
				<defaultState>Closed</defaultState>
				<anchor>Middle</anchor>
				<tKey>FSFTweaksGlobalResetTitle</tKey>
				<settings>

			<li Class="XmlExtensions.Setting.GapLine">
			</li>
			
			<!-- Reset All Mod Settings -->
			
			<li Class="XmlExtensions.Setting.SetColor">
				<color>(187,0,0)</color>
			</li>
			<li Class="XmlExtensions.Setting.Text">
				<text>Clicking the reset button below will reset all mod settings in this tweak pack.  This action cannot be undone.</text>
				<font>Medium</font>
				<anchor>Middle</anchor>
				<tKey>FSFTweaksGlobalResetDesc</tKey>
			</li>
			<li Class="XmlExtensions.Setting.SetColor"/>

			<li Class="XmlExtensions.Setting.ResetSettings"/>
					
			<li Class="XmlExtensions.Setting.GapLine">
				<spacing>12</spacing>
			</li>			
					
				</settings>
			</li>
						
						
						
				</value>
			</li>
				
			</operations>
		</Operation>
	
</Patch>