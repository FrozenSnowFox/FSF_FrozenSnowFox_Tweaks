<?xml version="1.0" encoding="utf-8"?>
<Patch>
	
	<Operation Class="XmlExtensions.OptionalPatch">
		<modId>FrozenSnowFox.FrozenSnowFoxTweaks</modId>
		<key>FSFNoImprovisedWeapons</key>
		<defaultValue>false</defaultValue>
		<caseTrue>
			
		<Operation Class="PatchOperationSequence">
			<success>Normal</success>
			<operations>
				
			<!-- No Improvised Weapons -->
				
			<!-- Ingestibles -->
				
			<li Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>/Defs/ThingDef [ingestible] [defName != "MeleeWeapon_Macecarab"] /equipmentType</xpath>
			</li>
			
			<li Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>/Defs/ThingDef [ingestible] [defName != "MeleeWeapon_Macecarab"] /comps/li[compClass="CompEquippable"]</xpath>
			</li>
				
			<li Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>/Defs/ThingDef [ingestible] [defName != "MeleeWeapon_Macecarab"] /weaponClasses</xpath>
			</li>
			
			<li Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>/Defs/ThingDef [ingestible] [defName != "MeleeWeapon_Macecarab"] /tools</xpath>
			</li>
				
			<!-- Resources -->
			
			<li Class="PatchOperationConditional">		
				<xpath>/Defs/ThingDef[@ParentName = "ResourceVerbBase"][thingCategories/li[text()="ResourcesRaw"]]</xpath>
				<match Class="PatchOperationAttributeSet">
					<xpath>/Defs/ThingDef[@ParentName = "ResourceVerbBase"][thingCategories/li[text()="ResourcesRaw"]]</xpath>
					<attribute>ParentName</attribute>
					<value>ResourceBase</value>
				</match>
			</li>
				
			<li Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>/Defs/ThingDef[thingCategories/li[text()="ResourcesRaw"]]/weaponClasses</xpath>
			</li>
			
			<li Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>/Defs/ThingDef[thingCategories/li[text()="ResourcesRaw"]]/tools</xpath>
			</li>
			
			<!-- Medieval Overhaul -->
			
			<li MayRequire="DankPyon.Medieval.Overhaul" Class="PatchOperationConditional">		
				<xpath>/Defs/ThingDef[@ParentName = "ResourceVerbBase"][thingCategories/li[text()="DankPyon_Wood"]]</xpath>
				<match Class="PatchOperationAttributeSet">
					<xpath>/Defs/ThingDef[@ParentName = "ResourceVerbBase"][thingCategories/li[text()="DankPyon_Wood"]]</xpath>
					<attribute>ParentName</attribute>
					<value>ResourceBase</value>
				</match>
			</li>
			
			<li MayRequire="DankPyon.Medieval.Overhaul" Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>/Defs/ThingDef[thingCategories/li[text()="DankPyon_Wood"]]/tools</xpath>
			</li>	
			
			<li MayRequire="DankPyon.Medieval.Overhaul" Class="PatchOperationConditional">		
				<xpath>/Defs/ThingDef[@ParentName = "ResourceVerbBase"][thingCategories/li[text()="DankPyon_RawWood"]]</xpath>
				<match Class="PatchOperationAttributeSet">
					<xpath>/Defs/ThingDef[@ParentName = "ResourceVerbBase"][thingCategories/li[text()="DankPyon_RawWood"]]</xpath>
					<attribute>ParentName</attribute>
					<value>ResourceBase</value>
				</match>
			</li>
			
			<li MayRequire="DankPyon.Medieval.Overhaul" Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>/Defs/ThingDef[thingCategories/li[text()="DankPyon_RawWood"]]/tools</xpath>
			</li>
			
			<li MayRequire="DankPyon.Medieval.Overhaul" Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>/Defs/ThingDef[@Name = "DankPyon_DrugBase"]/tools</xpath>
			</li>
				
			<!-- Vanilla Brewing Expanded -->
				
			<li MayRequire="VanillaExpanded.VBrewE" Class="XmlExtensions.PatchOperationSafeRemove">
				<xpath>/Defs/ThingDef[@Name = "VBE_DrugToolBase"]/tools</xpath>
			</li>
				
			</operations>
		</Operation>
			
		</caseTrue>
	</Operation>

</Patch>