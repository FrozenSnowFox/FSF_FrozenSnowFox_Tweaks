<?xml version="1.0" encoding="utf-8"?>
<Patch>
	
	<Operation Class="XmlExtensions.OptionalPatch">
		<modId>FrozenSnowFox.FrozenSnowFoxTweaks</modId>
		<key>FSFBetterQuestRewardsOn</key>
		<defaultValue>false</defaultValue>
		<caseTrue>
			
		<!-- Option is nested so patch isn't always run -->
			
			<!-- Better Quest Rewards -->
			
	<Operation Class="XmlExtensions.OptionalPatch">
		<modId>FrozenSnowFox.FrozenSnowFoxTweaks</modId>
		<key>FSFBetterQuestRewardsDevilstrand</key>
		<defaultValue>false</defaultValue>
		<caseTrue>
			
		<Operation Class="PatchOperationSequence">
			<success>Normal</success>
			<operations>
				
			<!-- Devilstrand -->
				
			<li Class="PatchOperationAdd">
				<xpath>/Defs/ThingSetMakerDef[defName = "Reward_ItemsStandard"]/root[@Class = "ThingSetMaker_Sum"]/options/li [minTotalMarketValue=5500]/thingSetMaker[@Class = "ThingSetMaker_RandomOption"]/options</xpath>
				<value>
					
			  <li>
                <weight>1</weight>
                <thingSetMaker Class="ThingSetMaker_MarketValue">
                  <fixedParams>
                    <filter>
                      <thingDefs>
                        <li>DevilstrandCloth</li>
                      </thingDefs>
                    </filter>
                  </fixedParams>
                </thingSetMaker>
              </li>
					
				</value>
			</li>
				
			</operations>
		</Operation>
			
		</caseTrue>
	</Operation>
	
	<Operation Class="XmlExtensions.OptionalPatch">
		<modId>FrozenSnowFox.FrozenSnowFoxTweaks</modId>
		<key>FSFBetterQuestRewardsLeather</key>
		<defaultValue>false</defaultValue>
		<caseTrue>
			
		<Operation Class="PatchOperationSequence">
			<success>Normal</success>
			<operations>
				
			<!-- Leather/Wool -->
				
			<li Class="PatchOperationAdd">
				<xpath>/Defs/ThingSetMakerDef[defName = "Reward_ItemsStandard"]/root[@Class = "ThingSetMaker_Sum"]/options/li [minTotalMarketValue=5500]/thingSetMaker[@Class = "ThingSetMaker_RandomOption"]/options</xpath>
				<value>
					
			  <li>
                <weight>1</weight>
                <thingSetMaker Class="ThingSetMaker_MarketValue">
                  <fixedParams>
                    <filter>
                      <categories>
                        <li>Leathers</li>
						<li>Wools</li>
                      </categories>
					  <disallowCheaperThan>8</disallowCheaperThan>
                    </filter>
                  </fixedParams>
                </thingSetMaker>
              </li>
					
				</value>
			</li>
				
			</operations>
		</Operation>
			
		</caseTrue>
	</Operation>
	
	<Operation Class="XmlExtensions.OptionalPatch">
		<modId>FrozenSnowFox.FrozenSnowFoxTweaks</modId>
		<key>FSFBetterQuestRewardsHyperweave</key>
		<defaultValue>false</defaultValue>
		<caseTrue>
			
