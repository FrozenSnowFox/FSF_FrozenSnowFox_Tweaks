				<value>
					
			  <li>
                <weight>0.5</weight>
                <thingSetMaker Class="ThingSetMaker_MarketValue">
                  <fixedParams>
                    <filter>
                      <thingDefs>
                        <li>Hyperweave</li>
                      </thingDefs>
                    </filter>
                  </fixedParams>
                </thingSetMaker>
              </li>
					
				</value>
			</li>
				
			</operations>
		</Operation>
			
		</caseTrue>
	</Operation>
			
