<?xml version="1.0" encoding="utf-8"?>
<Patch>
	
	<Operation Class="XmlExtensions.OptionalPatch">
		<modId>FrozenSnowFox.FrozenSnowFoxTweaks</modId>
		<key>FSFHarbingerSeedsOn</key>
		<defaultValue>false</defaultValue>
		<caseTrue>
			
		<!-- Option is nested so patch isn't always run -->
	
	<Operation Class="XmlExtensions.UseSettings">
		<modId>FrozenSnowFox.FrozenSnowFoxTweaks</modId>
		<keys>
			<li>FSFHarbingerSeedsMin</li>
			<li>FSFHarbingerSeedsMax</li>
		</keys>
		<defaultValues>
			<li>0</li>
			<li>1</li>
		</defaultValues>
		<apply>
			
		<Operation Class="PatchOperationSequence">
			<success>Normal</success>
			<operations>
			
			<!-- Harbinger Seeds on Traders -->

			<li Class="PatchOperationAdd">
				<xpath>/Defs/TraderKindDef[defName = "Caravan_Neolithic_ShamanMerchant"]/stockGenerators</xpath>
				<value>
					
					<li Class="StockGenerator_SingleDef">
						<thingDef>HarbingerSeed</thingDef>
						<countRange>{FSFHarbingerSeedsMin}~{FSFHarbingerSeedsMax}</countRange>
					</li>

				</value>
			</li>
				
			</operations>
		</Operation>
			
		</apply>
	</Operation>
			
		</caseTrue>
	</Operation>

</Patch>